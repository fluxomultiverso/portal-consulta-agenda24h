      "parameters": {
        "jsCode": "const c=$('Preparar contas').first().json,req=$('Expandir contas').all(),res=$input.all();if(req.length!==res.length)throw new Error('Falha ao criar acessos.');for(let i=0;i<req.length;i++){const id=res[i].json.id||res[i].json.user?.id;if(!id)throw new Error('Auth não retornou usuario_id.');const a=req[i].json.conta,o=(c.payload.operacoes[a.tipo==='profissional'?'profissionais':'recepcionistas']||[]).find(x=>x.chave===a.chave);o.dados.usuario_id=id;}return [{json:c}];"
