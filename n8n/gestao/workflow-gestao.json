      "parameters": {
        "jsCode": "const c=$json,p=JSON.parse(JSON.stringify(c.payload)),a=[];for(const o of p.operacoes.profissionais||[]){if(o.acao==='incluir'&&o.dados?.acesso_portal){if(!o.dados.email)throw new Error('E-mail obrigatório');a.push({tipo:'profissional',chave:o.chave,email:o.dados.email,nome:o.dados.nome});}}for(const o of p.operacoes.recepcionistas||[]){if(o.acao==='incluir'){a.push({tipo:'recepcionista',chave:o.chave,email:o.dados.email,nome:o.dados.nome});}}return [{json:{...c,payload:p,contas:a,tem_contas:a.length>0}}];"
